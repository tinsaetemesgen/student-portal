# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# NEVER commit .env — it holds live credentials.
# Get the real values from the team lead, not from the repo.

PORT=7000

# MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers -> copy the string, then set the db name to school-portal.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school-portal?retryWrites=true&w=majority

# If mongodb+srv:// fails with "querySrv ECONNREFUSED", your network blocks DNS SRV
# lookups. Use the non-SRV form instead — same cluster, no SRV lookup required.
# Atlas -> Connect -> Drivers -> "Node.js 2.2.12 or later" gives you this string.
# MONGODB_URI=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/school-portal?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority

# Signs login tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Password given to the accounts created by `npm run seed`.
SEED_PASSWORD=ChangeMe123!

NODE_ENV=development
